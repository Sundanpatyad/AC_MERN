# Base URL of the backend API.
# Leave unset to fall back to the deployed Cloud Run URL.
VITE_API_BASE_URL=http://localhost:8000

# Razorpay publishable key (must match the key used by the API to create orders)
VITE_APP_RAZORPAY_KEY=rzp_live_xxxxxxxxxxxx

# Firebase web config + Web Push (VAPID) key
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
